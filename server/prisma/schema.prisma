// Схема базы данных «Мигом».
// Статистика пользователей не хранится счётчиками — она считается из заказов, оценок и журнала баллов.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  courier
}

enum OrderStatus {
  new
  accepted
  picked
  delivered
  cancelled
}

enum PointsKind {
  welcome
  delivery_reward // курьеру за доставку
  order_cashback // клиенту за доставленный заказ
  achievement
  rating_thanks // за то, что оставил оценку
  five_stars // получил оценку 5★
  purchase // списание за приз
  demo_seed
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String
  role              Role
  isDemo            Boolean  @default(false)
  frame             String?
  lat               Float?
  lng               Float?
  address           String? // сохранённый адрес доставки клиента
  // Бонусы, купленные за баллы и ещё не использованные.
  freeDeliveryPerks Int      @default(0)
  discount10Perks   Int      @default(0)
  createdAt         DateTime @default(now())

  ordersAsCustomer Order[]           @relation("CustomerOrders")
  ordersAsCourier  Order[]           @relation("CourierOrders")
  ratingsGiven     Rating[]          @relation("RatingsGiven")
  ratingsReceived  Rating[]          @relation("RatingsReceived")
  achievements     UserAchievement[]
  purchases        Purchase[]
  points           PointsEntry[]
  events           OrderEvent[]
  messages         Message[]
}

model Store {
  id      String  @id
  name    String
  type    String
  icon    String
  address String
  lat     Float
  lng     Float
  orders  Order[]
}

model Order {
  id                String      @id @default(cuid())
  number            Int         @unique @default(autoincrement())
  customerId        String
  customer          User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  courierId         String?
  courier           User?       @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  storeId           String
  store             Store       @relation(fields: [storeId], references: [id])
  status            OrderStatus @default(new)
  itemsTotal        Int
  discount          Int         @default(0)
  deliveryFee       Int
  total             Int
  perksUsed         String[]
  dropoffLat        Float
  dropoffLng        Float
  dropoffAddress    String
  comment           String      @default("")
  distanceKm        Float
  reward            Int
  isNight           Boolean     @default(false)
  // Маршрут курьер → магазин → клиент: { coords, distanceKm, durationMin, pickupIndex }
  route             Json?
  courierDistanceKm Float? // длина маршрута курьера, идёт в его статистику
  createdAt         DateTime    @default(now())
  acceptedAt        DateTime?
  pickedAt          DateTime?
  deliveredAt       DateTime?

  items    OrderItem[]
  events   OrderEvent[]
  ratings  Rating[]
  points   PointsEntry[]
  messages Message[]

  @@index([status])
  @@index([customerId])
  @@index([courierId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name    String
  qty     Int
  price   Int
}

// История статусов заказа: кто и когда перевёл заказ в каждый статус.
model OrderEvent {
  id      String      @id @default(cuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status  OrderStatus
  actorId String?
  actor   User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  at      DateTime    @default(now())

  @@index([orderId])
}

model Rating {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromId    String
  from      User     @relation("RatingsGiven", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("RatingsReceived", fields: [toId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String   @default("")
  createdAt DateTime @default(now())

  // Каждый участник оценивает заказ один раз.
  @@unique([orderId, fromId])
  @@index([toId])
}

model UserAchievement {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@id([userId, achievementId])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prizeId   String
  title     String
  icon      String
  cost      Int
  code      String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

// Журнал баллов: баланс = сумма всех записей пользователя. Записи только добавляются.
model PointsEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  kind      PointsKind
  reason    String
  orderId   String?
  order     Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@index([userId])
}

// Чат клиента и курьера по заказу. readAt — когда сообщение прочитал получатель.
model Message {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromId    String
  from      User      @relation(fields: [fromId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([orderId, createdAt])
}
