# Строка подключения к PostgreSQL. Используйте 127.0.0.1 (не localhost) на Windows.
DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@127.0.0.1:5432/migom?schema=public"
# Отдельная база для автотестов — её очищают перед каждым прогоном.
TEST_DATABASE_URL="postgresql://postgres:ВАШ_ПАРОЛЬ@127.0.0.1:5432/migom_test?schema=public"
# Секрет для подписи JWT — любая длинная случайная строка.
JWT_SECRET="замените-на-длинную-случайную-строку"
